{
  "name": "coopeibm-dataapi",
  "version": "1.3.15",
  "description": "Apis para Cooperativa IBM",
  "keywords": [
    "loopback-application",
    "loopback"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "^22.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "build": "lb-tsc",
    "build:watch": "lb-tsc --watch",
    "lint": "npm run prettier:check && npm run eslint",
    "lint:fix": "npm run eslint:fix && npm run prettier:fix",
    "prettier:cli": "lb-prettier \"**/*.ts\" \"**/*.js\"",
    "prettier:check": "npm run prettier:cli -- -l",
    "prettier:fix": "npm run prettier:cli -- --write",
    "eslint": "lb-eslint --report-unused-disable-directives .",
    "eslint:fix": "npm run eslint -- --fix",
    "pretest": "npm run clean && npm run build",
    "test": "lb-mocha --allow-console-logs \"dist/__tests__\"",
    "posttest": "npm run lint",
    "test:dev": "lb-mocha --allow-console-logs dist/__tests__/**/*.js && npm run posttest",
    "docker:build": "docker build -t coopeibm-dataapi .",
    "docker:run": "docker run -p 3000:3000 -d coopeibm-dataapi",
    "migrate": "node ./dist/migrate",
    "openapi-spec": "node ./dist/openapi-spec",
    "start": "node dist/.",
    "clean": "lb-clean dist *.tsbuildinfo .eslintcache"
  },
  "repository": {
    "type": "git"
  },
  "author": "sergio.ramos@ibm.com",
  "license": "SEE LICENSE IN LICENSE file",
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "dependencies": {
    "@loopback/boot": "^9.0.0",
    "@loopback/core": "^7.0.15",
    "@loopback/extension-health": "^0.4.13",
    "@loopback/repository": "^8.0.15",
    "@loopback/rest": "^15.0.16",
    "@loopback/rest-crud": "^0.20.0",
    "@loopback/rest-explorer": "^9.0.0",
    "@loopback/service-proxy": "^9.0.0",
    "ibm_db": "^4.1.0",
    "loopback-connector-cloudant": "^2.5.0",
    "loopback-connector-db2": "^2.2.3",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@loopback/build": "^13.0.0",
    "@loopback/eslint-config": "^17.0.0",
    "@loopback/testlab": "^9.0.0",
    "@types/node": "^22",
    "eslint": "^8.57.1",
    "shelljs": "0.10.0",
    "source-map-support": "0.5.21",
    "tsc-watch": "7.2.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  }
}
